# Copy this file to .env and change the values. Never commit .env.

# Database password. Pick a long random value for real installs.
POSTGRES_PASSWORD=change-me

# Master key for webhook signing secrets. At least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it stable and back it up: changing it changes every webhook endpoint's secret.
DCP_SECRET_KEY=change-me-to-a-long-random-value-of-at-least-32-chars

# Quality checks read delivered files. Local files go in ./data (file:///data/... to DCP).
# For S3, set the standard AWS settings; for S3-compatible storage also set the endpoint.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# DCP_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com

# Keys for the local S3 storage in the dev profile (docker compose --profile dev up).
# DCP_DEV_S3_ACCESS_KEY=dcp-dev-access
# DCP_DEV_S3_SECRET_KEY=dcp-dev-secret-change-me

# Optional (defaults shown)
# POSTGRES_USER=dcp
# POSTGRES_DB=dcp
# DCP_PORT=8000          # port the API listens on at http://localhost:<port>
# LOG_LEVEL=INFO         # DEBUG, INFO, WARNING or ERROR

# Copy this file to .env and change the values. Never commit .env.

# Database password. Pick a long random value for real installs.
POSTGRES_PASSWORD=change-me

# Master key for webhook signing secrets. At least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it stable and back it up: changing it changes every webhook endpoint's secret.
DCP_SECRET_KEY=change-me-to-a-long-random-value-of-at-least-32-chars

# Optional (defaults shown)
# POSTGRES_USER=dcp
# POSTGRES_DB=dcp
# DCP_PORT=8000          # port the API listens on at http://localhost:<port>
# LOG_LEVEL=INFO         # DEBUG, INFO, WARNING or ERROR
